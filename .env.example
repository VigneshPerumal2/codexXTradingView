# TradingView Desktop CDP bridge. This machine uses 9333 because Chrome owns 9222.
TV_CDP_PORT=9333

# Local data store for V1. Keep this on the local Mac.
DATABASE_PATH=./data/papertrading.sqlite

# Queue/scheduler. Redis is required for the BullMQ production scheduler.
REDIS_URL=redis://127.0.0.1:6379
SUMMARY_TIMEZONE=America/Los_Angeles

# Safety gates. V1 must remain simulated/paper only.
PAPER_TRADING_MODE=paper
ENABLE_LIVE_BROKER=false
KILL_SWITCH=false

# Paper execution assumptions.
STARTING_CAPITAL=100000
MAX_DAILY_LOSS_PCT=0.02
MAX_POSITION_NOTIONAL_PCT=0.1
MAX_OPEN_POSITIONS=5
STALE_DATA_MS=60000
SLIPPAGE_BPS=5
FEE_BPS=1

# WhatsApp via Twilio. Sending is skipped unless WHATSAPP_ENABLED=true.
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=
TWILIO_SUMMARY_TEMPLATE_SID=
